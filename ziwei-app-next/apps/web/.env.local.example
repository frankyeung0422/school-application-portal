# ─── Database (Neon Postgres) ─────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/ziwei?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/ziwei?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET="generate-with: openssl rand -base64 64"
SESSION_COOKIE_NAME="ziwei_session"
SESSION_MAX_AGE_DAYS=30

# ─── Stripe (use TEST keys during P2; LIVE keys at cutover) ───
# Secret + publishable MUST be the same mode (both sk_test_/pk_test_, or both live).
# Local setup + webhook details: docs/stripe-local-testing.md
STRIPE_SECRET_KEY="sk_test_..."
# Local: the whsec_ printed by `pnpm --filter @ziwei/web stripe:listen`.
# Prod: the signing secret of the Dashboard webhook endpoint. A placeholder here
# makes every webhook 400 → no subscription syncs → paying users get no access.
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe price IDs (one set for test, replace with live at cutover)
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_ANNUAL="price_..."
STRIPE_PRICE_MASTER="price_..."

# Trial setup
STRIPE_TRIAL_DAYS=7

# ─── AI providers ─────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL_DEFAULT="claude-opus-4-7"

# Google Gemini via API Studio OR Vertex AI
GEMINI_API_KEY="..."
GEMINI_MODEL_DEFAULT="gemini-2.5-pro"

# ElevenLabs (voice TTS for daily fortune)
ELEVENLABS_API_KEY="..."
ELEVENLABS_VOICE_ID="..."

# AI cost guards
AI_DAILY_BUDGET_USD=50
AI_PER_REQUEST_BUDGET_USD=0.50

# ─── Email (SendGrid) ─────────────────────────────────────────
SENDGRID_API_KEY="SG...."
EMAIL_FROM="紫微閣 <noreply@aifortunetelling.org>"
EMAIL_REPLY_TO="support@aifortunetelling.org"

# ─── Storage (Cloudflare R2 for voice cache, OG images) ───────
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="ziwei-assets"
R2_PUBLIC_URL="https://assets.aifortunetelling.org"

# ─── Analytics ────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ─── Error tracking ───────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://...@o.....ingest.sentry.io/..."
SENTRY_AUTH_TOKEN="sntrys_..."
SENTRY_ORG="ziwei"
SENTRY_PROJECT="web"

# ─── Rate limiting (Upstash Redis) ────────────────────────────
# Free tier at https://upstash.com — 10k requests/day. Soft-fails open when unset.
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# ─── Google OAuth ─────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URIs MUST include (byte-exact match — port matters):
#   http://localhost:9001/api/auth/google/callback         (dev — app runs on 9001)
#   https://aifortunetelling.org/api/auth/google/callback  (prod)
# Scope used: openid email profile
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Threads (separate access token, distinct from FB page token) ─
THREADS_ACCESS_TOKEN=""

# ─── App config ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:9001"
NEXT_PUBLIC_SUPPORT_EMAIL="support@aifortunetelling.org"
NODE_ENV="development"

# ─── Marketing pipeline (P5) ──────────────────────────────────
FACEBOOK_PAGE_ID="..."
FACEBOOK_PAGE_ACCESS_TOKEN="..."
INSTAGRAM_USER_ID="..."
THREADS_USER_ID="..."
TIKTOK_OPEN_ID="..."
TIKTOK_ACCESS_TOKEN="..."
YOUTUBE_OAUTH_REFRESH_TOKEN="..."
XHS_ACCESS_TOKEN="..."

MARKETING_AUTO_POST=false
MARKETING_AUTOPUBLISH=false

# ─── Legacy migration (only during P2-W12 cutover) ────────────
LEGACY_SQLITE_PATH="C:/Projects/ziwei-app/data/fortune_app.db"
